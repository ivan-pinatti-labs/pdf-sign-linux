; SELinux type for the pdf-sign Reader container. GENERATED by generate.sh
; from the loaded policy (container-selinux-2.250.0-1.fc43.noarch selinux-policy-targeted-43.10-1.fc43.noarch); do not edit.
;
; pdf_sign_t is container_t (same attributes, and a copy of every
; unconditional rule the policy grants container_t by name), plus what a
; Wayland client needs: write to the compositor's socket file (user_tmp_t),
; connect to the compositor (gnome-shell runs as unconfined_t), and use the
; shared-memory files it passes back. The container's filesystem only
; exposes the Wayland socket, so that is all these rules make reachable.
;
; Install:  sudo semodule -i selinux/pdf_sign.cil   (make selinux)
; Remove:   sudo semodule -r pdf_sign

(type pdf_sign_t)
(roletype system_r pdf_sign_t)
(typeattributeset can_dump_kernel (pdf_sign_t))
(typeattributeset can_receive_kernel_messages (pdf_sign_t))
(typeattributeset container_domain (pdf_sign_t))
(typeattributeset container_net_domain (pdf_sign_t))
(typeattributeset corenet_unconfined_type (pdf_sign_t))
(typeattributeset corenet_unlabeled_type (pdf_sign_t))
(typeattributeset domain (pdf_sign_t))
(typeattributeset kernel_system_state_reader (pdf_sign_t))
(typeattributeset mcs_constrained_type (pdf_sign_t))
(typeattributeset pcmcia_typeattr_1 (pdf_sign_t))
(typeattributeset process_user_target (pdf_sign_t))
(typeattributeset sandbox_net_domain (pdf_sign_t))
(typeattributeset svirt_sandbox_domain (pdf_sign_t))
(typeattributeset syslog_client_type (pdf_sign_t))

