# Documents never belong in the repository: personal forms, government
# forms (copyrighted), signed copies. The inbox folder is committed, its
# contents never are.
/inbox/*
!/inbox/README.md
*.pdf
*.ps

# pre-commit
pre-commit.log

# Python (selinux/generate.py)
__pycache__/
*.pyc

# Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
.history/

# OS
.DS_Store
Thumbs.db

# Local secrets and scratch
.env
.env.local
*.local

# Personal AI agent files, never committed (see AGENTS.md)
CLAUDE.local.md
.claude/settings.local.json
.claude/agents/local/
.claude/worktrees/

# Coverage reports, written by `make coverage`
coverage/
